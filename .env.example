# Copy this file to ".env" and fill in your values.

# A GitHub Personal Access Token (classic or fine-grained) with "repo" read access.
# Needed to avoid low rate limits (60 req/hr unauthenticated -> 5000 req/hr with a token)
# and to read private repos if students' repos are private.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port the web server listens on
PORT=3000

# IANA timezone used to define "day" boundaries (so a commit at 11pm counts for the
# right day for your class), e.g. Asia/Kolkata, America/New_York, UTC
TIMEZONE=Asia/Kolkata

# Cron schedule (in TIMEZONE above) for automatic daily tracking.
# Default: "55 23 * * *" = 11:55 PM every day (captures that day's commits before it ends)
CRON_SCHEDULE=55 23 * * *
